# Copy to .env (git-ignored). Real environment variables override these.

# MySQL / MariaDB for saved lab reports (POST /lab-reports).
# The table is created on first use, but the database must exist and the
# user needs rights on it -- see "Step 4 - Database" in README.md:
#   CREATE DATABASE ocr CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
OCR_DB_HOST=127.0.0.1
OCR_DB_PORT=3306
OCR_DB_USER=ocr_app
OCR_DB_PASSWORD=
OCR_DB_NAME=ocr
